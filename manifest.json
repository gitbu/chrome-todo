{
  "manifest_version": 3,
  "name": "Todo Manager",
  "version": "3.0.0",
  "description": "TickTick风格的待办事项管理器，支持列表/项目、优先级、智能列表、无限子任务和搜索",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ]
}
